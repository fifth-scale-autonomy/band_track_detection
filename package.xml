<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>band_track_detection</name>
  <version>0.1.0</version>
  <description>흰 띠 트랙 경계 검출 (지면 투영, 띠 추출, 좌우 경계, 점 기억, 반대편 평행 생성) 과 지면 기준 노출 제어</description>
  <maintainer email="guswls264664@gmail.com">Hyeonjin Woo</maintainer>
  <license>AGPL-3.0-only</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>lavacone_fusion</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
